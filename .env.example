# Countersign runs with none of these set: every integration has a built-in stand-in.
# Add a key and restart to switch that integration to the real service.
PORT=3000
COMPANY_NAME=Tidewater Brewing Co.
APPROVER_NAME=Dana (Controller)

# Gemini: reads the invoice email and writes the verdict explanation
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# MongoDB Atlas: vendors, payment requests, case files, messages, ledger
MONGODB_URI=
MONGODB_DB=countersign
# Optional Atlas Search index on vendors.name for look-alike vendor search
ATLAS_SEARCH_INDEX=

# Tiger Data (TimescaleDB): payments hypertable and per-vendor baselines
TIGER_DATABASE_URL=

# Capital One Nessie: the operating account, merchants, bills and purchases
NESSIE_API_KEY=

# Solana devnet: anchors each ledger entry. Create a key with: node scripts/solana-setup.js
SOLANA_SECRET_KEY=
SOLANA_RPC_URL=https://api.devnet.solana.com

# Photon 2.0: texts the approver. All four are needed.
PHOTON_API_KEY=
PHOTON_PROJECT_ID=
PHOTON_PLATFORM=imessage
# The approver's own phone (E.164). Only this number can approve or hold.
PHOTON_APPROVER_HANDLE=

# Background worker: minutes before an unanswered hold gets one reminder text
REMIND_AFTER_MIN=30
